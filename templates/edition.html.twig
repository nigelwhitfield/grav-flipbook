{% extends 'partials/base.html.twig' %}
{% block assets %}
	 {% do assets.addJs('theme://js/page-flip.browser.js', { 'group': 'bottom' }) %}
{% do assets.addInlineCss('
    .q2-flipbook-wrapper { 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        margin: 2rem auto; 
        width: 80%; 
        clear: both;
    }
    #book { 
        box-shadow: 0 10px 30px rgba(0,0,0,0.15); 
        border-radius: 4px;
        overflow: hidden;
    }
    .my-page { 
        background-color: var(--card-background-color, #fff); 
        background-size: cover; 
        background-position: center; 
        box-sizing: border-box; 
    }
') %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
{% endblock %}
{% block content %}
    <article class="content-item">
          {{ page.content|raw }}

<div class="q2-flipbook-wrapper">
    <div id="book">
        {% for image in page.media.images %}
            {% set isCover = loop.first or loop.last %}
            <div class="my-page" 
                 data-density="{{ isCover ? 'hard' : 'soft' }}" 
                 style="background-image: url('{{ image.url }}'); width: 100%; height: 100%;">
		<img src="{{ image.url }}" alt="Manumission page">
            </div>
        {% endfor %}
    </div>
</div>

    </article>

{% endblock %}
{% block bottom %}
 {{ assets.js('bottom')|raw }}
<script>
document.addEventListener("DOMContentLoaded", function() {
    // Wait for the bottom asset pipeline to evaluate StPageFlip globally
    if (typeof St !== 'undefined' && St.PageFlip) {
        const pageFlip = new St.PageFlip(document.getElementById("book"), {
            width: 500,       // Matches your target page media proportions
            height: 700,      
            size: "stretch", 
            minWidth: 300,
            maxWidth: 1200,
            minHeight: 420,
            maxHeight: 1680,
            drawShadow: true,
            showCover: true,
            usePortrait: true // Set to false to allow twin side-by-side pages on Quark 2 desktops
        });

        pageFlip.loadFromHTML(document.querySelectorAll(".my-page"));
    }
});
</script>
{% endblock %}
